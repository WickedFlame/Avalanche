@using System.Linq
@using System.Text.Json
@model TestOverviewModel


<div class="pt-main-content">
    <aside class="menu px-4 py-4">
        <p class="menu-label">Menu</p>
        <ul class="menu-list">
            <li>Menu item</li>
        </ul>
    </aside>

    <div class="content px-6 py-4">
        <h1 class="title is-1">@Model.Name</h1>
        <div>
            <div class="pt-padding-side py-5">
                @if (Model.Status == Avalanche.Runner.TestRunStatus.Running)
                {
                    <div class="buttons has-addons">
                        <a id="StartTests" data-name="@Model.Name" class="button" disabled>Start</a>
                        <a id="StopTests" data-name="@Model.Name" data-testid="@Model.TestId" class="button">Stop</a>
                    </div>
                }
                else
                {
                    <div class="buttons has-addons">
                        <a id="StartTests" data-name="@Model.Name" class="button">Start</a>
                        <a id="StopTests" data-name="@Model.Name" data-testid="@Model.TestId" class="button" disabled>Stop</a>
                    </div>
                }
            </div>

            <div class="pt-element-container">
                <div class="pt-content-panel">
                    <div class="pt-stats">
                        <div class="pt-stat-item">
                            <header class="pt-stat-header">
                                Date
                            </header>
                            <div class="pt-stat-content">
                                <div class="content">
                                    @if (Model.StartTime != null)
                                    {
                                        <span>@Model.StartTime.Value.ToString("dd.MM.yyyy")</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </div>
                            </div>
                            <div class="pt-stat-footer">Startdate of the Test</div>
                        </div>
                        <div class="pt-stat-item">
                            <header class="pt-stat-header">
                                Start
                            </header>
                            <div class="pt-stat-content">
                                <div class="content">
                                    @if (Model.StartTime != null)
                                    {
                                        <span>@Model.StartTime.Value.ToString("HH:mm:ss")</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </div>
                            </div>
                            <div class="pt-stat-footer">Starttime</div>
                        </div>
                        <div class="pt-stat-item">
                            <header class="pt-stat-header">
                                Status
                            </header>
                            <div class="pt-stat-content">
                                <div class="content">
                                    @(Model.Status?.Name ?? "New")
                                </div>
                            </div>
                            <div class="pt-stat-footer">Status of the Scenario</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Settings != null)
        {
            <div class="pt-element-container">
                <div class="pt-content-panel">
                    <h2>Settings</h2>
                    <div class="overflow-x-auto">
                        <table class="table is-fullwidth">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Threads</th>
                                    <th>RampupTime</th>
                                    <th>Url</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var test in Model.Settings.Tests)
                                {
                                    <tr>
                                        <td>@test.Name</td>
                                        <td>@test.Threads</td>
                                        <td>@test.RampupTime</td>
                                        <td>
                                            <ul>
                                                @foreach(var url in test.Urls)
                                                {
                                                    <li>@url</li>
                                                }
                                            </ul>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <div class="pt-element-container" id="testsummary-@Model.TestId">
            <div class="pt-content-panel">
                <h2>Summaries</h2>
                <div class="overflow-x-auto">
                    <div class="pt-element-container">
                        <table class="table is-fullwidth">
                            <thead>
                                <tr>
                                    <th>TestCase</th>
                                    <th>Total Time</th>
                                    <th>Average Ticks</th>
                                    <th>Amount of iterations</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var test in Model.Settings.Tests)
                                {
                                    <partial name="./Partials/SummaryRow" for="@test" />
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="pt-element-container">
            <partial name="./Partials/Chart"/>
        </div>

        <div class="pt-element-container">
            <partial name="./Partials/RampupChart" />
        </div>

        <div>
            <div class="pt-content-panel">
                <h2>Thread Start</h2>
                <div class="overflow-x-auto">
                    <table class="table is-fullwidth">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Testname</th>
                                <th>Duration</th>
                                <th>Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.StartupEntries.Where(r => r.Module == "Init"))
                            {
                                <tr>
                                    <td>@row.Time.ToString("dd.MM.yyyy HH:mm:ss.ffff")</td>
                                    <td>@row.Name</td>
                                    <td>@row.ElapsedMilliseconds</td>
                                    <td>@row.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="pt-content-panel">
                <h2>Thread End</h2>
                <div class="overflow-x-auto">
                    <table class="table is-fullwidth">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Testname</th>
                                <th>Thread</th>
                                <th>Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.EndLogEntries.Where(r => r.Module == "End"))
                            {
                                <tr>
                                    <td>@row.Time.ToString("dd.MM.yyyy HH:mm:ss.ffff")</td>
                                    <td>@row.Name</td>
                                    <td>@row.Thread</td>
                                    <td>@row.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="pt-content-panel">
                <h2>Iterations</h2>
                <div class="overflow-x-auto">
                    <table class="table is-fullwidth">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Testname</th>
                                <th>IsWarmup</th>
                                <th>Thread</th>
                                <th>Number</th>
                                <th>Duration</th>
                                <th>Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.LogEntries.Where(r => r.Module == "Measure"))
                            {
                                <tr>
                                    <td>@row.Time.ToString("dd.MM.yyyy HH:mm:ss.ffff")</td>
                                    <td>@row.Name</td>
                                    <td>@row.IsWarmup</td>
                                    <td>@row.Thread</td>
                                    <td>@row.RunNumber</td>
                                    <td>@row.TotalMilliseconds</td>
                                    <td>@row.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>

</div>

@section scripts {
    <text>
        <script type="module" async>
            import { TestOverview } from '/js/testoverview.js';
            var sites = new TestOverview();

            @foreach (var test in Model.Settings.Tests)
            {
                <text>
                sites.initChart(@Html.Raw(JsonSerializer.Serialize(test, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase })), '@test.Name');
                sites.displayChart('@Model.Name', '@test.Name');
                sites.showSummaryData('@Model.Name', '@test.Name', '@Model.TestId');
                </text>
            }
        </script>
    </text>
}