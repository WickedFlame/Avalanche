@using System.Linq
@using System.Text.Json
@using Avalanche.Runner
@model TestOverviewModel

@section breadcrumb {
    <div class="pt-breadcrumb-panel">
        <nav class="breadcrumb" aria-label="breadcrumbs">
            <ul>
                <li><a asp-controller="Home" asp-action="Index">Scenarios</a></li>
                <li><a asp-controller="Scenario" asp-action="Index" asp-route-name="@Model.Scenario">@Model.Scenario</a></li>
                <li class="is-active"><a href="#" aria-current="page">Detail</a></li>
            </ul>
        </nav>
    </div>
}

<div class="pt-main-content">
    <div class="content px-6 py-4">
        <h1 class="title is-1">@Model.Scenario</h1>
        <div>
            <div class="pt-padding-side py-5">
                @if (Model.Status == Avalanche.Runner.TestRunStatus.Running)
                {
                    <div class="buttons has-addons">
                        <a id="StartTests" data-name="@Model.Scenario" class="button" disabled>Start</a>
                        <a id="StopTests" data-name="@Model.Scenario" data-testid="@Model.TestId" class="button">Stop</a>
                    </div>
                }
                else
                {
                    <div class="buttons has-addons">
                        <a id="StartTests" data-name="@Model.Scenario" class="button">Start</a>
                        <a id="StopTests" data-name="@Model.Scenario" data-testid="@Model.TestId" class="button" disabled>Stop</a>
                    </div>
                }
            </div>

            <div class="pt-element-container">
                <div class="pt-content-panel">
                    <div class="pt-stats">
                        <div class="pt-stat-item">
                            <header class="pt-stat-header">
                                Date
                            </header>
                            <div class="pt-stat-content">
                                <div class="content">
                                    @if (Model.StartTime != null)
                                    {
                                        <span>@Model.StartTime.Value.ToString("dd.MM.yyyy")</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </div>
                            </div>
                            <div class="pt-stat-footer">Startdate of the Test</div>
                        </div>
                        <div class="pt-stat-item">
                            <header class="pt-stat-header">
                                Start
                            </header>
                            <div class="pt-stat-content">
                                <div class="content">
                                    @if (Model.StartTime != null)
                                    {
                                        <span>@Model.StartTime.Value.ToString("HH:mm:ss")</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </div>
                            </div>
                            <div class="pt-stat-footer">Starttime</div>
                        </div>
                        <div class="pt-stat-item">
                            <header class="pt-stat-header">
                                Status
                            </header>
                            <div class="pt-stat-content">
                                <div class="content" id="scenario-status">
                                    @(Model.Status?.Name ?? "New")
                                </div>
                            </div>
                            <div class="pt-stat-footer">Status of the Scenario</div>
                        </div>
                        <div class="pt-stat-item">
                            <header class="pt-stat-header">
                                Run by
                            </header>
                            <div class="pt-stat-content">
                                <div class="content" id="scenario-runner">
                                    @(Model.Runner?.Name ?? "")
                                </div>
                            </div>
                            <div class="pt-stat-footer">Source of the runner</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Settings != null)
        {
            <div class="pt-element-container">
                <div class="pt-content-panel">
                    <h2>Scenario</h2>
                    <div class="overflow-x-auto">
                        <table class="table is-fullwidth">
                            <thead>
                                <tr>
                                    <th>TestCase</th>
                                    <th>Users</th>
                                    <th>Iterations</th>
                                    <th>Rampup</th>
                                    <th>URL</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var test in Model.Settings.TestCases)
                                {
                                    <tr>
                                        <td>@test.Name</td>
                                        <td>@test.Users</td>
                                        <td>@test.Iterations</td>
                                        <td>@test.RampupTime</td>
                                        <td>
                                            <ul>
                                                @foreach(var url in test.Urls)
                                                {
                                                    <li>@url</li>
                                                }
                                            </ul>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <div class="tabs is-medium">
            <ul>
                @{
                    var summaryActive = Model.Status != TestRunStatus.Done || string.IsNullOrEmpty(Model.Tab) || Model.Tab == "data" ? "is-active" : "";
                    var chartsActive = Model.Tab == "charts" ? "is-active" : "";
                    var detailActive = Model.Tab == "details" ? "is-active" : "";
                }
                <li class="@summaryActive"><a asp-controller="TestOverview" asp-action="Index" asp-route-scenario="@Model.Scenario" asp-route-testid="@Model.TestId">Summary</a></li>
                @if (Model.Status == TestRunStatus.Done)
                {
                    <li class="@chartsActive"><a asp-controller="TestOverview" asp-action="Index" asp-route-scenario="@Model.Scenario" asp-route-testid="@Model.TestId" asp-route-tab="charts">Charts</a></li>
                    <li class="@detailActive"><a asp-controller="TestOverview" asp-action="Index" asp-route-scenario="@Model.Scenario" asp-route-testid="@Model.TestId" asp-route-tab="details">Details</a></li>
                }
            </ul>
        </div>

        @if (string.IsNullOrEmpty(Model.Tab))
        {
            <div class="pt-element-container" id="testsummary-@Model.TestId" style="display: none;">
                <div class="pt-content-panel">
                    <h2>Summary</h2>
                    <div class="overflow-x-auto">
                        <div class="pt-element-container">
                            <table class="table is-fullwidth">
                                <thead>
                                    <tr>
                                        <th>TestCase</th>
                                        <th>Total Time</th>
                                        <th>Average (ms)</th>
                                        <th>Throughput / s</th>
                                        <th># Iterations</th>
                                        <th># Fails</th>
                                        <th>Slowest (ms)</th>
                                        <th>Fastest (ms)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var test in Model.Settings.TestCases)
                                    {
                                        <partial name="./Partials/SummaryRow" for="@test" />
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (Model.Tab == "charts")
        {
            foreach (var config in Model.Settings.TestCases)
            {
                <div class="pt-element-container py-6">
                    <h2>@config.Name</h2>
                    <partial name="./Partials/Chart" for="@config" />
                    <partial name="./Partials/Throughput" for="@config" />
                    @* <partial name="./Partials/RampupChart" for="@config" /> *@
                </div>
            }
        }
        else if (Model.Tab == "details")
        {
            <div class="pt-info-panel">
                <p>To enhance performance not all measured iterations are stored.<br />
                We only store a summary of iterations per user each second.</p>
            </div>

            @foreach (var testCase in Model.Details)
            {
                <div class="pt-element-container">
                    <div class="pt-content-panel">
                        <h2>@testCase.Key</h2>
                        <div class="overflow-x-auto">
                            <div class="pt-element-container">
                                <table class="table is-fullwidth">
                                    <thead>
                                        <tr>
                                            <th>Time</th>
                                            <th>ThreadId</th>
                                            <th>Throughput / s</th>
                                            <th>Average (ms)</th>
                                            <th>IsWarmup</th>
                                            <th>Error</th>
                                            <th>StatusCode</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var detailRow in testCase.Value.OrderBy(t => t.Time))
                                        {
                                            <partial name="./Partials/DetailRow" for="@detailRow" />
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

</div>

@section scripts {
    <text>
        <script type="module" async>
            import { TestOverview } from '/js/testoverview.js';
            var sites = new TestOverview();

            @foreach (var test in Model.Settings.TestCases)
            {
                @if (Model.Status == TestRunStatus.Done && Model.Tab == "charts")
                {
                    <text>
                        sites.initChart(@Html.Raw(JsonSerializer.Serialize(test, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase })), '@test.Name');
                        sites.displayChart('@Model.Scenario', '@test.Name', '@Model.TestId');
                    </text>
                }
            }

            sites.initSummaryDataPoller('@Model.Scenario', '@Model.TestId');
        </script>
    </text>
}