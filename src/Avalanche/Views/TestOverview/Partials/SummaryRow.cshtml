@model Avalanche.Runner.TestCase
<tr id="@Model.Name.Replace(" ", "_")">
    <td class="TestCase">@Model.Name</td>
    <td class="TotalTime"></td>
    <td class="AverageMs"></td>
    <td class="Throughput"></td>
    <td class="Iterations"></td>
    <td class="Fails"></td>
    <td class="Slowest"></td>
    <td class="Fastest"></td>
</tr>


