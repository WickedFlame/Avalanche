@model TestOverviewModel

@foreach (var chart in Model.Settings.Tests)
{
    var id = $"chart-{chart.Name.Replace(" ", "_")}-rampup";

    <div class="pt-content-panel">
        <h3 class="title is-6">
            Rampup - @chart.Name
        </h3>
        <div>
            @* <canvas id="myChart" style="width:100%;max-width:700px"></canvas> *@
            <canvas id="@id" style="width:100%;max-width:100%;height:400px;"></canvas>
        </div>
    </div>
}


