@using Avalanche.ReadModel.Models
@model IterationItem
<tr>
    <td>@Model.Time.ToString("dd.MM.yyyy hh:mm:ss")</td>
    <td>@Model.ThreadId</td>
    <td>@Model.Throughput</td>
    <td>@Model.AverageMilliseconds</td>
    <td>@Model.IsWarmup</td>
    <td>@Model.Error</td>

    @if (string.IsNullOrEmpty(Model.StatusCode))
    {
        <td></td>
    }
    else
    {
        <td>
            @Model.StatusCode <span class="icon pt-info-icon">
                <i class="fa fa-info-circle" title="@Model.Message"></i>
            </span>
        </td>
    }
</tr>


