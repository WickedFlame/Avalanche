@using System.Linq
@using System.Text.Json
@model ScenarioModel

@section breadcrumb {
    <div class="pt-breadcrumb-panel">
        <nav class="breadcrumb" aria-label="breadcrumbs">
            <ul>
                <li><a asp-controller="Home" asp-action="Index">Scenarios</a></li>
                <li class="is-active"><a href="#" aria-current="page">@Model.Name</a></li>
            </ul>
        </nav>
    </div>
}

<div class="pt-main-content">
    <div class="content px-6 py-4">
        
        <h1 class="title is-1">@Model.Name</h1>
        <div>
            <div class="pt-padding-side py-5">
                <div class="buttons">
                    @if (Model.Status == Avalanche.Runner.TestRunStatus.Running)
                    {
                        <div class="buttons has-addons" style="margin-bottom:0;">
                            <a id="StartTests" data-name="@Model.Name" class="button" disabled>Start</a>
                            <a id="StopTests" data-name="@Model.Name" class="button" disabled>Stop</a>
                        </div>
                    }
                    else
                    {
                        <div class="buttons has-addons" style="margin-bottom:0;">
                            <a id="StartTests" data-name="@Model.Name" class="button">Start</a>
                            <a id="StopTests" data-name="@Model.Name" class="button" disabled>Stop</a>
                        </div>
                    }

                    @if(Model.Runs.Any())
                    {
                        <a asp-controller="Scenario" asp-action="Statistics" asp-route-name="@Model.Name" class="button">Statistics</a>
                    }
                    else
                    {
                        <a class="button" disabled>Statistics</a>
                    }

                    <div class="navbar-end">
                        <div class="buttons has-addons" style="margin-bottom:0;">
                            <a asp-controller="ScenarioEditor" asp-action="Index" asp-route-scenario="@Model.Name" class="button">Edit scenario</a>
                            <a class="button" id="btn_del_scenario" title="Delete the Scenario and all Testruns">
                                <span class="icon">
                                    <i class="fa fa-trash"></i>
                                </span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-element-container">
                <div class="pt-content-panel">
                    <div class="pt-stats">
                        <div class="pt-stat-item">
                            <header class="pt-stat-header">
                                Date
                            </header>
                            <div class="pt-stat-content">
                                <div class="content">
                                    @if (Model.StartTime != null)
                                    {
                                        <span>@Model.StartTime.Value.ToString("dd.MM.yyyy")</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </div>
                            </div>
                            <div class="pt-stat-footer">Startdate of the Test</div>
                        </div>
                        <div class="pt-stat-item">
                            <header class="pt-stat-header">
                                Start
                            </header>
                            <div class="pt-stat-content">
                                <div class="content">
                                    @if (Model.StartTime != null)
                                    {
                                        <span>@Model.StartTime.Value.ToString("HH:mm:ss")</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </div>
                            </div>
                            <div class="pt-stat-footer">Starttime</div>
                        </div>
                        <div class="pt-stat-item">
                            <header class="pt-stat-header">
                                Status
                            </header>
                            <div class="pt-stat-content">
                                <div class="content">
                                    @(Model.Status?.Name ?? "New")
                                </div>
                            </div>
                            <div class="pt-stat-footer">Status of the Scenario</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Settings != null)
        {
            <div class="pt-element-container">
                <div class="pt-content-panel">
                    <h2>Scenario</h2>
                    <div class="overflow-x-auto">
                        <table class="table is-fullwidth is-hoverable">
                            <thead>
                                <tr>
                                    <th>TestCase</th>
                                    <th>Users</th>
                                    <th>Iterations</th>
                                    <th>Rampup</th>
                                    <th>URL</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var test in Model.Settings.TestCases)
                                {
                                    <tr>
                                        <td>@test.Name</td>
                                        <td>@test.Users</td>
                                        <td>@test.Iterations</td>
                                        <td>@test.RampupTime</td>
                                        <td>
                                            <ul style="list-style-type: none;">
                                                @foreach (var url in test.Urls)
                                                {
                                                    <li><a href="@url" target="_blank">@url</a></li>
                                                }
                                            </ul>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }


        <div class="pt-element-container">
            <div class="pt-content-panel">
                <h2>Testruns</h2>
                <div class="overflow-x-auto">
                    <table class="table is-fullwidth is-hoverable">
                        <thead>
                            <tr>
                                <th style="width: 300px;">Run at</th>
                                <th style="width: 300px;">End Time</th>
                                <th style="width: 200px;">Status</th>
                                <th>Source</th>
                                <th style="width: 20%;"></th>
                                <th style="width: 1px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var test in Model.Runs)
                            {
                                <tr>
                                    <td><a asp-controller="TestOverview" asp-action="Index" asp-route-scenario="@test.Scenario" asp-route-testid="@test.TestId">@test.StartTime.ToString("dd.MM.yyyy hh:mm:ss")</a></td>
                                    <td>@(test.EndTime > DateTime.MinValue ? test.EndTime.ToString("dd.MM.yyyy hh:mm:ss") : string.Empty)</td>
                                    <td>@test.Status</td>
                                    <td>@test.Runner</td>
                                    <td></td>
                                    <td>
                                        <a class="pt-button" asp-controller="Scenario" asp-action="DeleteTestRun" asp-route-scenario="@test.Scenario" asp-route-testid="@test.TestId">
                                            <span class="icon">
                                                <i class="fa fa-trash"></i>
                                            </span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


<div id="delScenario" class="modal">
    <div class="modal-background"></div>
    <div class="modal-content">
        <div class="box">
            <div class="pt-messagebox">
                <div class="pt-messagebox-header">
                    <div class="title is-4">
                        Delete Scenario
                    </div>
                    <button class="modal-close is-large pt-cancel-btn" aria-label="close"></button>
                </div>
                <div class="pt-messagebox-content">
                    This will delete the whole Scenario and all coresponding Measuremantes.<br />
                    Are you sure that you want to continue?
                </div>
            </div>
            <div class="buttons">
                <a class="button pt-cancel-btn">
                    Cancel
                </a>
                <a asp-controller="Scenario" asp-action="DeleteScenario" asp-route-scenario="@Model.Name" class="button">
                    Delete
                </a>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <text>
        <script type="module" async>
            import { TestOverview } from '/js/testoverview.js';
            var sites = new TestOverview();
        </script>
    </text>
}