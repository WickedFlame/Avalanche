@model ScenarioEditorModel

@section breadcrumb {
    <div class="pt-breadcrumb-panel">
        <nav class="breadcrumb" aria-label="breadcrumbs">
            <ul>
                <li><a asp-controller="Home" asp-action="Index">Scenarios</a></li>
                <li class="is-active"><a href="#" aria-current="page">Edit Scenarios</a></li>
            </ul>
        </nav>
    </div>    
}

<div class="pt-navigation-container">
    <nav class="navbar pt-navbar-main" role="navigation" aria-label="main navigation">
        <a role="button" class="navbar-burger" data-target="navMenu" aria-label="menu" aria-expanded="true">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
        </a>
        <div class="navbar-menu" id="navMenu">
            <div class="pt-padding-side">
                <aside class="menu px-4 py-4">
                    <p class="menu-label">Edit</p>
                    <ul class="menu-list">
                        <li><a asp-controller="ScenarioEditor" asp-action="Index">New Scenario</a></li>
                    </ul>
                    <p class="menu-label">Scenarios</p>
                    <ul class="menu-list">
                        @foreach (var scenario in Model.Scenarios)
                        {
                            <li><a asp-controller="ScenarioEditor" asp-action="Index" asp-route-scenario="@scenario">@scenario</a></li>
                        }
                    </ul>
                </aside>
            </div>
        </div>
    </nav>

    <div class="pt-main-content">
        <div class="content px-6 py-4">
            

            <h1 class="title is-1">Edit Scenarios</h1>


            <div>
                @using (Html.BeginForm("SaveScenario", "ScenarioEditor", FormMethod.Post, new { id = "SaveScenario" }))
                {
                    <div class="content-header content-container" id="sticky-header">
                        <div class="field">
                            <label class="field-label">Scenario*</label>
                            <div class="control">
                                <input class="input" type="text" placeholder="Scenario..." asp-for="@Model.Name" />
                            </div>
                        </div>
                        <div class="field">
                            <label class="field-label">Configuration*</label>
                            <div class="control">
                                <textarea class="textarea" rows="35" asp-for="@Model.RawContent"></textarea>
                            </div>
                        </div>
                        <div class="field">
                            <div class="control">
                                <button type="submit" id="save-changes" form="SaveScenario" class="button">Save</button>
                            </div>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@section scripts {
    @* <text>
        <script type="module" async>
            import { TestOverview } from '/js/testoverview.js';
            var sites = new TestOverview();
        </script>
    </text> *@
