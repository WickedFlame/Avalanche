@model TestsViewModel
@{
    ViewData["Title"] = "Home Page";
}


<div class="pt-padding pt-padding-side">
    <div class="pt-main-content">
        <aside class="menu pt-padding-side">
            <p class="menu-label">Test Scenarios</p>
            <ul class="menu-list">
                @foreach (var test in Model.Tests)
                {
                    <li><a asp-controller="TestOverview" asp-action="Index" asp-route-name="@test.Name">@test.Name</a></li>
                }
            </ul>
        </aside>


        <div class="content pt-padding-side">
            <h1 class="title is-1">Welcome</h1>
            <p>Loadtesting platform</p>
            <div>
                <div></div>
                <div>
                    @* <h2>Tests</h2>
                    <div>
                        <div>
                            @foreach (var test in Model.Tests)
                            {
                                <div>@test.Name</div>
                            }
                        </div>
                    </div> *@
                </div>
            </div>
        </div>
        
    </div>
</div>