@using Avalanche.Domain
@model TestsViewModel
@{
    ViewData["Title"] = "Home Page";
}


<div class="pt-main-content">
    <aside class="menu px-4 py-4">
        <p class="menu-label">Test Scenarios</p>
        <ul class="menu-list">
            @foreach (var test in Model.Tests)
            {
                <li><a asp-controller="TestOverview" asp-action="Index" asp-route-name="@test.Name">@test.Name</a></li>
            }
        </ul>
    </aside>


    <div class="content px-6 py-4">
        <h1 class="title is-1">Avalanche</h1>
        <p>Loadtesting platform</p>
        <div>
            <div></div>
            <div class="pt-grid">
                <div class="pt-row pt-row-header pt-test-overview-row">
                    <div>Testscenario</div>
                    <div>State</div>
                    <div></div>
                    <div></div>
                </div>
                @foreach (var test in Model.Tests)
                {
                    var stateCls = test.State.Name switch
                    {
                        "New" => "is-white",
                        "Running" => "is-link",
                        "Done" => "is-success",
                        _ => "is-white"
                    };
                    
                    <div class="pt-row pt-test-overview-row">
                        <a asp-controller="TestOverview" asp-action="Index" asp-route-name="@test.Name">@test.Name</a>
                        <div><div class="tag @stateCls">@test.State</div></div>
                        <div></div>
                        <div></div>
                    </div>
                }
                @* <h2>Tests</h2>
                <div>
                    <div>
                        @foreach (var test in Model.Tests)
                        {
                            <div>@test.Name</div>
                        }
                    </div>
                </div> *@
            </div>
        </div>
    </div>
        
</div>